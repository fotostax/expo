+      desc.format != AHARDWAREBUFFER_FORMAT_Y8Cb8Cr8_420) {
+    EXGLSysLog("Unsupported hardware buffer format %d", desc.format);
+    return 0;
+  }
+
+  int width = static_cast<int>(desc.width);
+  int height = static_cast<int>(desc.height);
+
